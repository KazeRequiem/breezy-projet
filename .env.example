
# Configuration Breezy — copier ce fichier en .env et remplir

# MongoDB
# Identifiants du compte root MongoDB (créés au premier démarrage)
MONGO_USER=breezy
MONGO_PASSWORD=change_me
MONGO_DB=breezy_db

# Mongo Express (interface d'admin web de la base)
# Identifiants de connexion à l'UI Mongo Express
ME_USER=admin
ME_PASSWORD=change_me

# Vault (gestion des secrets)
# Token root du Vault en mode dev
VAULT_TOKEN=change_me

# JWT (authentification)
# Secret de signature des tokens JWT — utiliser une valeur longue et aléatoire
JWT_SECRET=change_me_with_a_long_random_string

# Application (back)
# Port d'écoute de l'API
APP_PORT=3000
# Origine autorisée pour le CORS (URL du front)
CORS_ORIGIN=http://localhost:5173